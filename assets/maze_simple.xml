<mujoco model="simple_maze">
  <compiler angle="radian" coordinate="local"/>
  
  <option timestep="0.01" gravity="0 0 -9.81"/>
  
  <default>
    <geom type="box" rgba="0.8 0.8 0.8 1" friction="1 0.005 0.0001"/>
  </default>
  
  <asset>
    <texture name="wall_texture" type="2d" builtin="checker" rgb1="0.7 0.7 0.7" rgb2="0.6 0.6 0.6" width="300" height="300"/>
    <material name="wall_material" texture="wall_texture" texrepeat="3 3"/>
  </asset>
  
  <worldbody>
    <!-- Ground plane (already added in Genesis, this is just for reference) -->
    <!-- <geom name="floor" type="plane" size="10 10 0.1" pos="0 0 0" rgba="0.5 0.5 0.5 1"/> -->
    
    <!-- Outer boundary walls (10m x 10m arena) -->
    <body name="north_wall" pos="0 5 1">
      <geom name="wall_north" type="box" size="5 0.1 1" material="wall_material"/>
    </body>
    
    <body name="south_wall" pos="0 -5 1">
      <geom name="wall_south" type="box" size="5 0.1 1" material="wall_material"/>
    </body>
    
    <body name="east_wall" pos="5 0 1">
      <geom name="wall_east" type="box" size="0.1 5 1" material="wall_material"/>
    </body>
    
    <body name="west_wall" pos="-5 0 1">
      <geom name="wall_west" type="box" size="0.1 5 1" material="wall_material"/>
    </body>
    
    <!-- Internal maze walls to create corridors -->
    
    <!-- Central vertical divider with gap -->
    <body name="divider_1" pos="0 -2 1">
      <geom name="div_1" type="box" size="0.1 2 1" material="wall_material"/>
    </body>
    
    <body name="divider_2" pos="0 2.5 1">
      <geom name="div_2" type="box" size="0.1 1.5 1" material="wall_material"/>
    </body>
    
    <!-- Horizontal walls to create T-junctions and turns -->
    <body name="h_wall_1" pos="-2.5 2 1">
      <geom name="hw_1" type="box" size="1.5 0.1 1" material="wall_material"/>
    </body>
    
    <body name="h_wall_2" pos="2.5 -2 1">
      <geom name="hw_2" type="box" size="1.5 0.1 1" material="wall_material"/>
    </body>
    
    <body name="h_wall_3" pos="-2 -0.5 1">
      <geom name="hw_3" type="box" size="1.5 0.1 1" material="wall_material"/>
    </body>
    
    <body name="h_wall_4" pos="2 0.5 1">
      <geom name="hw_4" type="box" size="1.5 0.1 1" material="wall_material"/>
    </body>
    
    <!-- Additional vertical segments for complexity -->
    <body name="v_wall_1" pos="-3 -2.5 1">
      <geom name="vw_1" type="box" size="0.1 1.5 1" material="wall_material"/>
    </body>
    
    <body name="v_wall_2" pos="3 2.5 1">
      <geom name="vw_2" type="box" size="0.1 1.5 1" material="wall_material"/>
    </body>
    
    <!-- Some obstacles/pillars -->
    <body name="pillar_1" pos="-1.5 1 1">
      <geom name="p_1" type="cylinder" size="0.2 1" rgba="0.6 0.4 0.4 1"/>
    </body>
    
    <body name="pillar_2" pos="1.5 -1 1">
      <geom name="p_2" type="cylinder" size="0.2 1" rgba="0.6 0.4 0.4 1"/>
    </body>
    
  </worldbody>
</mujoco>
